const app = document.getElementById('app');
const sectionFilters = document.getElementById('sectionFilters');

const searchBox = document.getElementById('searchBox');
const visibleCount = document.getElementById('visibleCount');
const answeredCount = document.getElementById('answeredCount');
const totalCount = document.getElementById('totalCount');
const scoreBtn = document.getElementById('scoreBtn');
const resetBtn = document.getElementById('resetBtn');
const scoreBox = document.getElementById('scoreBox');
const scoreText = document.getElementById('scoreText');
const scoreDetail = document.getElementById('scoreDetail');
const state = { section: 'all', subtopic: 'all', query: '' };
const uniqueSections = [...new Set(questions.map(q => q.s))];
const uniqueSubtopics = [...new Set(questions.map(q => q.t))];

totalCount.textContent = questions.length;

function buildChip(label, value, current, onClick) {
  const chip = document.createElement('button');
  chip.className = 'chip' + (String(current) === String(value) ? ' active' : '');
  chip.textContent = label;
  chip.onclick = () => onClick(value);
  return chip;
}

function renderFilters() {
  sectionFilters.innerHTML = '';
  sectionFilters.appendChild(buildChip('All', 'all', state.section, (value) => {
    state.section = value;
    if (value !== 'all') state.subtopic = 'all';
    render();
  }));
  uniqueSections.forEach(section => {
    sectionFilters.appendChild(buildChip(sectionNames[section], section, state.section, (value) => {
      state.section = value;
      state.subtopic = 'all';
      render();
    }));
  });


}

function filteredQuestions() {
  return questions.filter(q => {
    const sectionMatch = state.section === 'all' || String(q.s) === String(state.section);
    const subtopicMatch = state.subtopic === 'all' || q.t === state.subtopic;
    const haystack = `${sectionNames[q.s]} ${q.t} ${q.stem} ${q.options.join(' ')} ${q.explanation}`.toLowerCase();
    const queryMatch = !state.query || haystack.includes(state.query.toLowerCase());
    return sectionMatch && subtopicMatch && queryMatch;
  });
}

function updateAnsweredCount() {
  answeredCount.textContent = [...document.querySelectorAll('.card')].filter(card => card.querySelector('input[type="radio"]:checked')).length;
}

function createCard(q) {
  const card = document.createElement('div');
  card.className = 'card';
  const letters = ['A', 'B', 'C', 'D'];
  card.innerHTML = `
    <div class="meta">
      <span class="pill qnum">#${q.id}</span>
      <span class="pill">${sectionNames[q.s]}</span>
      <span class="pill">${q.t}</span>
    </div>
    <div class="stem">${q.stem}</div>
    <div class="options"></div>
    <div class="actions">
      <button class="reveal">Reveal answer</button>
      <button class="clear">Clear selection</button>
    </div>
    <div class="answer-panel">
      <div class="answer-line">Correct answer: ${letters[q.answer]}</div>
      <div class="explanation">${q.explanation}</div>
    </div>
  `;
  const optionsNode = card.querySelector('.options');
  q.options.forEach((opt, idx) => {
    const label = document.createElement('label');
    label.className = 'option';
    label.innerHTML = `<input type="radio" name="q-${q.id}" value="${idx}"/><div><strong>${letters[idx]}.</strong> ${opt}</div>`;
    label.querySelector('input').addEventListener('change', updateAnsweredCount);
    optionsNode.appendChild(label);
  });

  const reveal = card.querySelector('.reveal');
  const clear = card.querySelector('.clear');
  const panel = card.querySelector('.answer-panel');
  reveal.onclick = () => {
    panel.classList.toggle('show');
    reveal.textContent = panel.classList.contains('show') ? 'Hide answer' : 'Reveal answer';
    const picked = card.querySelector('input[type="radio"]:checked');
    [...card.querySelectorAll('.option')].forEach((node, idx) => {
      node.classList.remove('correct', 'wrong');
      if (panel.classList.contains('show')) {
        if (idx === q.answer) node.classList.add('correct');
        if (picked && Number(picked.value) === idx && idx !== q.answer) node.classList.add('wrong');
      }
    });
  };
  clear.onclick = () => {
    const picked = card.querySelector('input[type="radio"]:checked');
    if (picked) picked.checked = false;
    [...card.querySelectorAll('.option')].forEach(node => node.classList.remove('correct', 'wrong'));
    updateAnsweredCount();
  };
  return card;
}

function render() {
  renderFilters();
  const filtered = filteredQuestions();
  visibleCount.textContent = filtered.length;
  app.innerHTML = '';
  let currentSection = null;
  let currentSubtopic = null;
  filtered.forEach(q => {
    if (q.s !== currentSection) {
      currentSection = q.s;
      currentSubtopic = null;
      const title = document.createElement('div');
      title.className = 'section-title';
      title.textContent = sectionNames[q.s];
      app.appendChild(title);
    }
    if (q.t !== currentSubtopic) {
      currentSubtopic = q.t;
    }
    app.appendChild(createCard(q));
  });
  updateAnsweredCount();
}

searchBox.addEventListener('input', (e) => { state.query = e.target.value.trim(); render(); });
scoreBtn.onclick = () => {
  const cards = [...document.querySelectorAll('.card')];
  let attempted = 0;
  let correct = 0;
  cards.forEach(card => {
    const id = Number(card.querySelector('.qnum').textContent.replace('#',''));
    const q = questions.find(x => x.id === id);
    const picked = card.querySelector('input[type="radio"]:checked');
    if (picked) { attempted += 1; if (Number(picked.value) === q.answer) correct += 1; }
  });
  scoreBox.style.display = 'block';
  scoreText.textContent = `${correct} / ${attempted}`;
  scoreDetail.textContent = attempted ? `Accuracy on answered visible questions: ${Math.round(correct * 100 / attempted)}%.` : 'Answer some visible questions to compute a score.';
};
resetBtn.onclick = () => {
  document.querySelectorAll('input[type="radio"]').forEach(i => i.checked = false);
  document.querySelectorAll('.option').forEach(n => n.classList.remove('correct', 'wrong'));
  document.querySelectorAll('.answer-panel').forEach(p => p.classList.remove('show'));
  document.querySelectorAll('.reveal').forEach(b => b.textContent = 'Reveal answer');
  scoreBox.style.display = 'none';
  updateAnsweredCount();
};
document.getElementById('expandAllBtn').onclick = () => document.querySelectorAll('.reveal').forEach(btn => { if (btn.textContent === 'Reveal answer') btn.click(); });
document.getElementById('collapseAllBtn').onclick = () => document.querySelectorAll('.reveal').forEach(btn => { if (btn.textContent === 'Hide answer') btn.click(); });
render();
})();
</script>
