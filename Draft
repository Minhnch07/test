import base64
 
input_file = "test_base64.txt"
output_file = "restored.docx"
 
# đọc toàn bộ base64
with open(input_file, "r", encoding="utf-8") as f:
    b64 = f.read()
 
# loại bỏ whitespace, newline
b64 = "".join(b64.split())
 
# decode
docx_bytes = base64.b64decode(b64)
 
# ghi file
with open(output_file, "wb") as f:
    f.write(docx_bytes)
 
print(f"Created: {output_file}")
